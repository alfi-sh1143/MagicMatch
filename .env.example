# =====================================================================
# MAGICMATCH BOOTH — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# NOTE: Never commit sensitive credentials or .env files to source control.
# Copy this file to .env for local overrides.

# ---------------------------------------------------------------------
# 1. OPTIONAL REMOTE PERSISTENCE (Supabase / PostgreSQL)
# ---------------------------------------------------------------------
# When these two variables are provided, MagicMatch automatically transitions
# from "LOCAL MODE" (in-memory & local browser storage) to "CONNECTED".
#
# IMPORTANT SECURITY NOTICE:
# Frontend applications MUST ONLY use the PUBLIC/PUBLISHABLE anon client key.
# NEVER put the service_role key, database connection string, or postgres
# password in this file or any client environment configuration.

# Supabase Project URL (e.g. https://your-project.supabase.co)
# VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon Client Key (Safe for browser client)
# VITE_SUPABASE_ANON_KEY="your-public-anon-key-here"

# ---------------------------------------------------------------------
# 2. HARDWARE PERIPHERAL DRIVER SELECTION
# ---------------------------------------------------------------------
# Printer interface selection:
# "browser"       - Standard window.print() targeting browser print spool
# "escpos_usb"    - Direct ESC/POS binary command stream with auto-cut
# "serial"        - RS-232 / COM port thermal printer bridge
VITE_PRINTER_INTERFACE="browser"

# Camera input driver selection:
# "browser"       - WebRTC navigator.mediaDevices.getUserMedia()
# "virtual_demo"  - Synthetic multi-filter test generator for headless testing
# "gphoto2_dslr"  - Tethered USB DSLR driver via PTP/IP
VITE_CAMERA_SOURCE="browser"

# ---------------------------------------------------------------------
# 3. KIOSK HOSTING & DOMAIN RESOLUTION
# ---------------------------------------------------------------------
# Public domain used when encoding QR codes for mobile visitors
# E.g. https://booth.yourvenue.com
APP_URL="https://your-booth-domain.com"

# ---------------------------------------------------------------------
# 4. OPTIONAL AI LAYER
# ---------------------------------------------------------------------
# Optional API key for generating creative hangout icebreaker copy.
# The core matching engine is 100% deterministic and runs without any AI API.
# GEMINI_API_KEY="your-gemini-api-key"
